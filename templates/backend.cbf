#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <time.h>
#include <stdarg.h>
#include <signal.h>

#define BUFFER_SIZE 4096
// I don't remember if there's a reason for these limits
#define MAX_ENDPOINT_LENGTH 200
#define MAX_QUERY_STRING_LENGTH 100

#define DEBUG 0

int server_fd, new_socket;
char* response;

void log_message(const char *format, ...) {
    time_t now = time(NULL);
    struct tm *tm_info = localtime(&now);
    char timestamp[20];
    strftime(timestamp, sizeof(timestamp), "%Y-%m-%d %H:%M:%S", tm_info);

    printf("[%s] ", timestamp);

    va_list args;
    va_start(args, format);
    vprintf(format, args);
    va_end(args);

    printf("\n");
}

void handle_signal(int sig) {
	log_message("Handling SIGINT\n");
    close(new_socket);
    close(server_fd);
    log_message("Server shut down gracefully\n");
    free(response);
    exit(0);
}

// assumed parameter like: "asd=dsa&l=yes SomethingNotParsed"
void parse_query_string(char* string, char* out_query_string) {
	if (DEBUG) log_message("[DEBUG] First character from query string to be parsed: %c", string[0]);
	for (int i=0; i < MAX_QUERY_STRING_LENGTH; i++) {
		char out_query_string_char = string[i];
		if (out_query_string_char == ' ') {
			out_query_string[i] = '\0';
			return;
		}
		out_query_string[i] = out_query_string_char;
	}
	out_query_string[MAX_QUERY_STRING_LENGTH-1] = '\0';
    log_message("[ERROR] Did not manage to parse full query string, too big.");
}

void handle_request(char buffer[BUFFER_SIZE], int socket) {
	if (buffer[0] != 'G' || buffer[1] != 'E' || buffer[2] != 'T') {
        sprintf(response, "HTTP/1.1 400 Bad Request\r\n");
        send(new_socket, response, strlen(response), 0);
		return;
	}

	// request should start with "GET /enpoint "
	// endpoint variable will have '/' included in it, and not include the query string
	char endpoint[MAX_ENDPOINT_LENGTH];
	char query_string[MAX_QUERY_STRING_LENGTH]; // carefull! 'query_string' is used by code generation mechanics (templates)
	query_string[0]='\0';
	for (int i=0; i < MAX_ENDPOINT_LENGTH; i++) {
		char endpoint_char = buffer[4 + i];
		if (endpoint_char == ' ') {
			endpoint[i] = '\0';
			break;
		}
		if (endpoint_char == '?') {
			endpoint[i] = '\0';
			parse_query_string(buffer + 4 + i + 1, query_string);
			break;
		}
		endpoint[i] = endpoint_char;
	}


    if (strcmp(query_string, "") == 0) {
        log_message("[INFO] Empty endpointquery string from request");
	} else {
        log_message("[INFO] Query string parsed from request: %s", query_string);
	}

	char* response_content;
	

	// CBF-ENDPOINT-SWITCH-CASE

    if (strcmp(endpoint, "") == 0) {
        log_message("[INFO] Empty endpoint from request");
        return;
	}

    log_message("[WARN] Ignoring request. Endpoint not matched: %s ", endpoint);
    return;
}


int main(int argc, char* argv[]) {
	if (argc != 2) {
    	fprintf(stderr, "Usage: %s <port>\n", argv[0]);
    	return 1;
	}
	int port = atoi(argv[1]);
    response = (char *)malloc(BUFFER_SIZE * sizeof(char));

    signal(SIGINT, handle_signal); // Handle Ctrl+C
	
    struct sockaddr_in address;
    socklen_t addr_len = sizeof(address);
    char buffer[BUFFER_SIZE];

    server_fd = socket(AF_INET, SOCK_STREAM, 0);
    address.sin_family = AF_INET;
    address.sin_addr.s_addr = INADDR_ANY;
    address.sin_port = htons(port);

    bind(server_fd, (struct sockaddr *)&address, sizeof(address));
    listen(server_fd, 10);

    log_message("Listening on port %d...\n\n", port);
    while (1) {
        new_socket = accept(server_fd, (struct sockaddr *)&address, &addr_len);
        read(new_socket, buffer, BUFFER_SIZE);
        log_message("Received request:\n%s\n", buffer);

        handle_request(buffer, new_socket);
		close(new_socket);
    }

    free(response);
    close(server_fd);
    return 0;
}
